# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Telegram Bot API token obtained from @BotFather.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_API_BASE: Optional reverse proxy URL (e.g. Cloudflare Worker) to bypass Telegram blocking.
TELEGRAM_API_BASE="https://telegram-proxy.yourname.workers.dev"
